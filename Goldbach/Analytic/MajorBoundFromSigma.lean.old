/-
  Major bound for the Hardy–Littlewood main term `M(N) = σ(N) * N / (log N)^2`,
  derived from a window-wise lower bound on the singular series.

  No axioms/sorries: you supply the σ-lower bound for your working window.
-/
import Mathlib

import Goldbach.SingularSeries   -- sigma, C2Const
import Goldbach.MainTerm         -- M
import Goldbach.Windows          -- Windows.EvenIn
import Goldbach.AnalyticAssemble -- MajorBound

open scoped BigOperators

namespace Goldbach.Analytic

open Singular MainTerm AnalyticAssemble

/-- A window-wise lower bound for the singular series σ, parameterized by `C2`. -/
structure SigmaLowerOn (X0 H : ℕ) (C : Singular.C2Const) (σmin : ℝ) : Prop :=
  (σmin_pos : 0 < σmin)
  (bound    : ∀ {X N}, X0 ≤ X → N ∈ Windows.EvenIn X H →
                Singular.sigma C N ≥ σmin)

/-- Helper: for even `N ≥ 2`, the factor `N / (log N)^2` is nonnegative. -/
private lemma factor_nonneg (N : ℕ) (hN2 : 2 ≤ N) :
    0 ≤ (N : ℝ) / (Real.log (N : ℝ))^2 := by
  have hlogpos : 0 < Real.log (N : ℝ) := by
    have h1ltN : (1 : ℝ) < (N : ℝ) := by exact_mod_cast lt_of_lt_of_le (by decide : 1 < 2) hN2
    simpa [Real.log_pos_iff] using h1ltN
  have hdenpos : 0 < (Real.log (N : ℝ))^2 := sq_pos_of_pos hlogpos
  have hN0 : 0 ≤ (N : ℝ) := by exact_mod_cast Nat.zero_le N
  exact div_nonneg hN0 (le_of_lt hdenpos)

private lemma one_le_nat_div_log_sq {N : ℕ} (hN2 : 2 ≤ N) :
    (1 : ℝ) ≤ (N : ℝ) / (Real.log (N : ℝ))^2 := by
  set x : ℝ := (N : ℝ)
  have hx1 : (1 : ℝ) < x := by
    -- from 2 ≤ N
    have : (2 : ℝ) ≤ x := by exact_mod_cast hN2
    have : (1 : ℝ) < x := lt_of_lt_of_le (by norm_num : (1 : ℝ) < 2) this
    simpa [x] using this
  have hxpos : (0 : ℝ) < x := lt_trans (by norm_num : (0 : ℝ) < 1) hx1

  -- Let y = log x. We show y^2 ≤ exp y = x.
  set y : ℝ := Real.log x
  have hy0 : 0 ≤ y := by
    have hxle1 : (1 : ℝ) ≤ x := le_of_lt hx1
    simpa [y] using Real.log_nonneg hxle1

  have hy_le_exp_half : y ≤ Real.exp (y / 2) := by
    -- `Real.two_mul_le_exp` at (y/2): 2*(y/2) ≤ exp(y/2), i.e. y ≤ exp(y/2)
    have h := (Real.two_mul_le_exp (x := y / 2))
    -- simplify 2 * (y/2) = y
    simpa [two_mul, add_halves] using h

  have hy_sq_le_exp : y^2 ≤ Real.exp y := by
    -- square both sides: y^2 ≤ (exp(y/2))^2 = exp y
    have hpow : y^2 ≤ (Real.exp (y / 2))^2 :=
      pow_le_pow_of_le_left hy0 hy_le_exp_half 2
    -- rewrite RHS
    simpa [pow_two, ← Real.exp_add, add_halves] using hpow

  have hlog_sq_le : (Real.log x)^2 ≤ x := by
    -- exp (log x) = x for x>0
    simpa [y, x, Real.exp_log hxpos] using hy_sq_le_exp

  have hden_pos : 0 < (Real.log x)^2 := by
    have : 0 < Real.log x := Real.log_pos hx1
    exact pow_pos this 2

  -- Convert `(log x)^2 ≤ x` to `1 ≤ x / (log x)^2`
  have : (1 : ℝ) ≤ x / (Real.log x)^2 := (one_le_div hden_pos).2 hlog_sq_le
  simpa [x] using this


/-- Major bound from a σ-lower bound (scale-aware HL form). -/
lemma major_of_sigma_lower
    {X0 H : ℕ} {S c0 σmin : ℝ} {C : Singular.C2Const}
    (A   : SigmaLowerOn X0 H C σmin)
    (hcs : c0 * S ≤ σmin)
    (two_le_of_mem : ∀ {X N}, X0 ≤ X → N ∈ Windows.EvenIn X H → 2 ≤ N) :
    AnalyticAssemble.MajorBound X0 H S c0 (MainTerm.M C) := by
  intro X N hX hN
  -- lower bound on σ
  have hσ : Singular.sigma C N ≥ σmin := A.bound hX hN
  -- nonnegative factor
  have hN2 : 2 ≤ N := two_le_of_mem hX hN
  have hfac : 0 ≤ (N : ℝ) / (Real.log (N : ℝ))^2 := factor_nonneg N hN2
  -- M = σ * factor
  have step1 : MainTerm.M C N ≥ σmin * (N : ℝ) / (Real.log (N : ℝ))^2 := by
    simp only [MainTerm.M, mul_div_assoc]
    exact mul_le_mul_of_nonneg_right hσ hfac
  have step2 :
      c0 * S * (N : ℝ) / (Real.log (N : ℝ))^2
        ≤ σmin * (N : ℝ) / (Real.log (N : ℝ))^2 := by
    have := mul_le_mul_of_nonneg_right hcs hfac
    ring_nf at this ⊢
    exact this
  have hMfac :
      c0 * S * (N : ℝ) / (Real.log (N : ℝ))^2 ≤ MainTerm.M C N := by
    -- this is just your old calc, but stated as ≤
    have := (show MainTerm.M C N ≥ σmin * (N : ℝ) / (Real.log (N : ℝ))^2 from step1)
    have := (show c0 * S * (N : ℝ) / (Real.log (N : ℝ))^2 ≤ σmin * (N : ℝ) / (Real.log (N : ℝ))^2 from step2)
    exact le_trans this step1

  by_cases hcs0 : c0 * S ≤ 0
  · -- negative case: it suffices to show 0 ≤ M
    have hσfac0 : 0 ≤ σmin * (N : ℝ) / (Real.log (N : ℝ))^2 :=
      mul_nonneg (le_of_lt hσmin) hfac
    have hM0 : 0 ≤ MainTerm.M C N := le_trans hσfac0 (show σmin * (N : ℝ) / (Real.log (N : ℝ))^2 ≤ MainTerm.M C N from step1)
    exact le_trans hcs0 hM0
  · -- positive case: use factor ≥ 1
    have hcspos : 0 < c0 * S := lt_of_not_ge hcs0
    have hfac1 : (1 : ℝ) ≤ (N : ℝ) / (Real.log (N : ℝ))^2 :=
      one_le_nat_div_log_sq (two_le_of_mem hX hN)
    have ha0 : 0 ≤ c0 * S := le_of_lt hcspos
    have hmul : c0 * S ≤ c0 * S * ((N : ℝ) / (Real.log (N : ℝ))^2) := by
      have := mul_le_mul_of_nonneg_left hfac1 ha0
      simpa [mul_assoc] using this
    exact le_trans hmul hMfac

/-- Specialization at `S = 1`: it suffices to supply `c0 ≤ σmin`. -/
lemma major_of_sigma_lower_S1
    {X0 H : ℕ} {c0 σmin : ℝ} {C : Singular.C2Const}
    (A   : SigmaLowerOn X0 H C σmin)
    (hc0 : c0 ≤ σmin)
    (two_le_of_mem : ∀ {X N}, X0 ≤ X → N ∈ Windows.EvenIn X H → 2 ≤ N) :
    AnalyticAssemble.MajorBound X0 H (1 : ℝ) c0 (MainTerm.M C) := by
  intro X N hX hN
  have h := major_of_sigma_lower (A:=A) (S:=1) (c0:=c0) (σmin:=σmin)
      (hcs := by simp [mul_one]; exact hc0)
      (two_le_of_mem := two_le_of_mem) hX hN
  simp only [mul_one] at h ⊢
  exact h

end Goldbach.Analytic
