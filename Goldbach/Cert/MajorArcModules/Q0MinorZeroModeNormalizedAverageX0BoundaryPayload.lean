import Goldbach.Cert.MajorArcModules.Q0MinorZeroModeNormalizedAverage

namespace Goldbach.Cert.MajorArcModules.Q0MinorZeroModeNormalizedAverage

def surrogateBoundaryX0ActiveSignedExactCert : ℚ :=
  (- : ℚ) / 

def surrogateBoundaryX0InactiveCorrectionExactCert : ℚ :=
  (- : ℚ) / 

def surrogateBoundaryX0FullExactCert : ℚ :=
  surrogateBoundaryX0ActiveSignedExactCert + surrogateBoundaryX0InactiveCorrectionExactCert


theorem surrogateBoundaryX0FullExactCert_abs_le_26 :
    |(surrogateBoundaryX0FullExactCert : ℝ)| ≤ 26 := by
  norm_num [surrogateBoundaryX0FullExactCert,
            surrogateBoundaryX0ActiveSignedExactCert,
            surrogateBoundaryX0InactiveCorrectionExactCert]

theorem abs_surrogateBoundary_X0_le_26_from_exact_cert
    (hcert :
      surrogateCenteredNormalizedSigmaTruncPeriodicBoundaryPairSumUpToQ0Rat X0
        = surrogateBoundaryX0FullExactCert) :
    |surrogateCenteredNormalizedSigmaTruncPeriodicBoundaryPairSumUpToQ0 X0|
      ≤ 26 := by
  rw [surrogateCenteredNormalizedSigmaTruncPeriodicBoundaryPairSumUpToQ0_eq_ratCast]
  rw [hcert]
  exact surrogateBoundaryX0FullExactCert_abs_le_26

end Goldbach.Cert.MajorArcModules.Q0MinorZeroModeNormalizedAverage
