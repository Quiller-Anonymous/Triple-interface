private theorem gcd_g_h_eq_one_of_coprime_moduli
    {q q' g h : ℕ} (hcop : Nat.Coprime q q')
    (hg : g ∈ q.divisors) (hh : h ∈ q'.divisors) :
    Nat.gcd g h = 1 := by
