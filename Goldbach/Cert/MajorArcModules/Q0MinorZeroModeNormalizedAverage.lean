  · intro g hg
    have hg_dvd_q : g ∣ q := (Nat.mem_divisors.mp hg).1
    exact Nat.mem_divisors.mpr ⟨⟨g, (Nat.div_mul_cancel hg_dvd_q).symm⟩, hq0⟩
  · intro a ha
