theorem centeredRamanujanPairCleanPeriodicGcdCorrectionTerm_eq_coprime_moduli
    {X q q' : ℕ} (hq : 1 ≤ q) (hq' : 1 ≤ q') (hcop : Nat.Coprime q q') :
    centeredRamanujanPairCleanPeriodicGcdCorrectionTerm X q q'
      =
