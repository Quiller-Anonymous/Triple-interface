      if Goldbach.Windows.IsEven q ∧ q / 2 ≠ q' then
        normalizedSigmaTruncSummandRealCoeff q
          * normalizedSigmaTruncSummandRealCoeff q'
          * centeredRamanujanPairPeriodicMainOddOddSector X (q / 2) q'
