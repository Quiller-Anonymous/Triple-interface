theorem rawEvenRamanujanGcdClassRightBlockPeriodicCount_eq_two_mul_of_two_mul_odd_left_divisor_of_coprime
    {X n q' h : ℕ} (hnOdd : Odd n) (hq' : 1 ≤ q')
