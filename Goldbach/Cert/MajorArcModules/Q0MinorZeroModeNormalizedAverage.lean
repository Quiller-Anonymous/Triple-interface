private theorem rawEvenRamanujanPairPeriodicFloor_eq_zero_of_two_mul_gcd_lt
    {q q' g h : ℕ}
    (hlt : 2 * Nat.gcd g h < Nat.gcd q q') :
    (2 * Nat.gcd g h) / Nat.gcd q q' = 0 := by
