          push_cast
          ring
      _ = -∑ g ∈ n.divisors, ramanujanGcdClassCoeff n g * (Nat.totient (n / g) : ℝ) := by
          rw [← Finset.sum_neg_distrib]
  simpa [hodd] using hsum

