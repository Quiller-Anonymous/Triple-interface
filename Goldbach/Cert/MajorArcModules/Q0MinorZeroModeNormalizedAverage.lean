      (((↑(EvenIn X H).card : ℂ)⁻¹).re) = (((EvenIn X H).card : ℝ)⁻¹) := by
    rw [← Complex.ofReal_natCast, ← Complex.ofReal_inv, Complex.ofReal_re]
