      exact centeredRamanujanPairCleanPeriodicOddPartBaseSum_le_self_of_factorization_two_le
        (Nat.ordCompl_pos 2 hq0).ne' hsup.2
    have hmul_le :
        (((2 ^ (q.factorization 2 - 2) : ℕ) : ℝ)
          * centeredRamanujanPairCleanPeriodicOddPartBaseSum m)
