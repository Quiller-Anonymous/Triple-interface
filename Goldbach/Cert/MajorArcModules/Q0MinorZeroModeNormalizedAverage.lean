  rw [hDensity]

theorem rawEvenRamanujanGcdClassPeriodicCoefficientMismatchTerm_eq_exact_gcd_floor_overlap
    {X q q' g h : ℕ} (hq : 1 ≤ q) (hq' : 1 ≤ q')
