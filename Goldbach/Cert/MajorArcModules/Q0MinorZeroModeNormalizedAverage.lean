  ∑ N ∈ EvenIn X H, ‖centeredNormalizedSigmaTruncSummand S X q N‖ ^ 2

theorem centeredRawHalfMassTrueTailResidual_windowRawSum_eq_zero
    (S : TrueSingularSeriesOnWindow)
    {X : ℕ} (_hX : X0 ≤ X) :
