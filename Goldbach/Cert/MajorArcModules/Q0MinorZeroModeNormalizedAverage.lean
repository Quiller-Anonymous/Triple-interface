    centeredRamanujanPairCleanPeriodicRemainderTerm
  trans
    ∑ g ∈ q.divisors.filter Goldbach.Windows.IsEven,
      ∑ h ∈ q'.divisors.filter Goldbach.Windows.IsEven,
