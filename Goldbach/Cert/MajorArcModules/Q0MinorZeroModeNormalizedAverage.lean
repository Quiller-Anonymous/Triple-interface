    _ ≤ (((H + 1 : ℕ) : ℝ)
          * (2 * ((Goldbach.AO_OffDiag.TailBlock.Q0 : ℝ) / ramanujanSeriesOnWindow.C.C2)) ^ 2) := by
          have hcard : ((EvenIn X H).card : ℝ) ≤ ((H + 1 : ℕ) : ℝ) := by
