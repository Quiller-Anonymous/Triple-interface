import SSU.Engines.LargeSieve.MontgomeryVaughanTypeII

/-!
MV-by-residue analytic inputs.

These are the only remaining “hard” analytic hypotheses needed to run the non-fallback Step 3/4
route for broad extracted families (after any gcd-reduction needed to build a `TubeData`).

Constant policy:
* `C3 td` and `C4 td` depend only on the tube parameters packaged in `td`;
* they are independent of `F, f, i, j, ξ, r`.
-/

namespace SSU
namespace Engines
namespace TypeII
namespace LargeSieve

open scoped BigOperators

noncomputable section

/-- **Analytic input (Step 3, per-residue MV).**

For every `td : TubeData`, we assume a Montgomery–Vaughan large sieve bound restricted to each
residue class `uClass td r`, with a parameter-only constant `C = C3 td`. -/
axiom step3MV_byResidue (td : TubeData) : Step3MontgomeryVaughanByResidue td

/-- **Analytic input (Step 4, per-residue MV).**

For every `td : TubeData`, we assume a Montgomery–Vaughan large sieve bound restricted to each
residue class `vClass td r`, with a parameter-only constant `C = C4 td`. -/
axiom step4MV_byResidue (td : TubeData) : Step4MontgomeryVaughanByResidue td

/-- Parameter-only Step 3 MV constant. -/
noncomputable def C3 (td : TubeData) : ℝ :=
  (step3MV_byResidue td).C

/-- Parameter-only Step 4 MV constant. -/
noncomputable def C4 (td : TubeData) : ℝ :=
  (step4MV_byResidue td).C

theorem C3_nonneg (td : TubeData) : 0 ≤ C3 td :=
  (step3MV_byResidue td).C_nonneg

theorem C4_nonneg (td : TubeData) : 0 ≤ C4 td :=
  (step4MV_byResidue td).C_nonneg

/-- Expanded Step 3 per-residue bound, in the exact shape your constructors consume. -/
theorem step3MV_byResidue_bound (td : TubeData) :
    ∀ ξ : ℝ, ξ ≠ 0 → |ξ| ≤ (1 / td.H) →
      ∀ F : TubePoint → ℂ,
        ∀ r ∈ ResiduePartition.residuesU td,
          (∑ u ∈ ResiduePartition.uClass td r, ‖innerSumUZ td ξ F u‖ ^ 2)
            ≤
          (C3 td) * ((td.D / (td.q : ℝ)) * (td.U + td.X / |ξ|) *
            (∑ u ∈ ResiduePartition.uClass td r,
              ∑ z ∈ zSet td u, ‖∑ p ∈ fiberUZ td u z, F p‖ ^ 2)) :=
  (step3MV_byResidue td).bound

/-- Expanded Step 4 per-residue bound, in the exact shape your constructors consume. -/
theorem step4MV_byResidue_bound (td : TubeData) :
    ∀ ξ : ℝ, ξ ≠ 0 → |ξ| ≤ (1 / td.H) →
      ∀ F : TubePoint → ℂ,
        ∀ r ∈ ResiduePartitionV.residuesV td,
          (∑ v ∈ ResiduePartitionV.vClass td r, ‖innerSumVZ td ξ F v‖ ^ 2)
            ≤
          (C4 td) * (td.D * (td.U / (td.q : ℝ) + td.X / |ξ|) *
            (∑ v ∈ ResiduePartitionV.vClass td r,
              ∑ z ∈ zSetV td v, ‖∑ p ∈ fiberVZ td v z, F p‖ ^ 2)) :=
  (step4MV_byResidue td).bound

end LargeSieve
end TypeII
end Engines
end SSU

