#
# NOTE (2026-01-03):
# This `.yml.chunks` file is *not* a GitHub Actions workflow (only `.yml` / `.yaml` are picked up).
# The working CI implementation that follows this idea now lives in:
#   `.github/workflows/lean_action_ci.yml`
#
# Common copy/paste pitfalls in this draft (fixed in the real workflow):
# - Use `.github/...` (no stray spaces).
# - Run `lake` commands from the repo root (don’t `cd` into `Goldbach/FiniteBase/Chunks`).
# - Chunk module names are `Goldbach.FiniteBase.Chunks.<Module>` (no spaces in the module path).
# - Build artifacts live under `.lake/build/lib/lean/...` and are `.olean` + `.ilean` (no stray spaces).
#
name: Build All Chunks (Parallel)

on:
  push:
    paths:  
      - 'Goldbach/FiniteBase/Chunks/**'
      - '. github/workflows/lean_action_ci.yml'
  pull_request:
    paths: 
      - 'Goldbach/FiniteBase/Chunks/**'
  workflow_dispatch: 

jobs:  
  # Job 1: Discover what chunks exist and create the build plan
  discover-chunks:  
    runs-on: ubuntu-latest
    outputs:
      total_chunks: ${{ steps. count.outputs.total }}
      chunk_groups: ${{ steps.create-groups.outputs.groups }}
    steps:
      - uses:  actions/checkout@v4
      
      - name: Count total chunks
        id: count
        run:  |
          cd Goldbach/FiniteBase/Chunks
          total=$(ls -1 Chunk*_verified.lean 2>/dev/null | wc -l)
          echo "total=$total" >> $GITHUB_OUTPUT
          echo "Found $total chunk files to build"
      
      - name: Create chunk groups
        id: create-groups
        run: |
          cd Goldbach/FiniteBase/Chunks
          
          # Get all chunk files and extract their prefixes (e.g., "000_a" from "Chunk000_a_verified.lean")
          # Group them by the numeric prefix (000, 001, etc.)
          prefixes=$(ls -1 Chunk*_verified.lean 2>/dev/null | \
            sed 's/Chunk\([0-9]\{3\}\)_.*/\1/' | \
            sort -u)
          
          # Convert to JSON array
          groups=$(echo "$prefixes" | jq -R -s -c 'split("\n") | map(select(length > 0))')
          
          echo "groups=$groups" >> $GITHUB_OUTPUT
          echo "Created $(echo $groups | jq 'length') groups"
          echo "Groups: $groups"

  # Job 2: Build chunks in parallel (grouped by prefix)
  build-chunks:  
    needs: discover-chunks
    runs-on: ubuntu-latest
    timeout-minutes: 360  # 6 hours per job
    strategy:
      matrix:  
        chunk_prefix: ${{ fromJson(needs.discover-chunks.outputs.chunk_groups) }}
      max-parallel: 40  # Use all Pro plan concurrent jobs! 
      fail-fast: false  # Continue other jobs even if one fails
    
    steps: 
      - uses: actions/checkout@v4
      
      - name:  Set up Lean
        uses:  leanprover/lean-action@v1
    
      - name: Fetch dependencies
        run: lake update
      
      - name: Build chunks ${{ matrix.chunk_prefix }}*
        id: build
        run: |
          cd Goldbach/FiniteBase/Chunks
          
          prefix="${{ matrix.chunk_prefix }}"
          
          echo "=========================================="
          echo "Building Group:  Chunk${prefix}*"
          echo "Time started:  $(date)"
          echo "=========================================="
          echo ""
          
          # Find all matching chunks
          matching_chunks=(Chunk${prefix}_*_verified.lean)
          
          # Check if any files match
          if [ !  -f "${matching_chunks[0]}" ]; then
            echo "No chunks found matching Chunk${prefix}_*_verified.lean"
            echo "This group is empty - skipping"
            exit 0
          fi
          
          echo "Found ${#matching_chunks[@]} chunk files in this group:"
          printf '  %s\n' "${matching_chunks[@]}"
          echo ""
          
          # Track progress
          failed_chunks=()
          successful_chunks=()
          start_time=$(date +%s)
          
          # Build each chunk
          chunk_num=0
          for chunk_file in "${matching_chunks[@]}"; do
            chunk_num=$((chunk_num + 1))
            module=$(basename "$chunk_file" .lean)
            
            echo "----------------------------------------"
            echo "[$chunk_num/${#matching_chunks[@]}] Building: $module"
            echo "Time:  $(date +%H:%M:%S)"
            echo "----------------------------------------"
            
            chunk_start=$(date +%s)
            
            if lake build "Goldbach. FiniteBase.Chunks.$module" 2>&1 | tee "build_${module}.log"; then
              chunk_end=$(date +%s)
              duration=$((chunk_end - chunk_start))
              echo "✓ SUCCESS: $module (${duration}s)"
              successful_chunks+=("$module")
            else
              chunk_end=$(date +%s)
              duration=$((chunk_end - chunk_start))
              echo "✗ FAILED: $module (${duration}s)"
              failed_chunks+=("$module")
            fi
            echo ""
          done
          
          # Calculate total time
          end_time=$(date +%s)
          total_duration=$((end_time - start_time))
          minutes=$((total_duration / 60))
          seconds=$((total_duration % 60))
          
          # Print summary
          echo ""
          echo "=========================================="
          echo "GROUP ${prefix} SUMMARY"
          echo "=========================================="
          echo "Total chunks:     ${#matching_chunks[@]}"
          echo "Successful:       ${#successful_chunks[@]}"
          echo "Failed:          ${#failed_chunks[@]}"
          echo "Total time:      ${minutes}m ${seconds}s"
          echo "Time completed:   $(date)"
          echo "=========================================="
          
          # List failures if any
          if [ ${#failed_chunks[@]} -gt 0 ]; then
            echo ""
            echo "FAILED CHUNKS:"
            printf '  ✗ %s\n' "${failed_chunks[@]}"
            echo ""
            echo "Check the logs above for error details"
            exit 1
          else
            echo ""
            echo "✓ All chunks in group ${prefix} built successfully!"
          fi
      
      - name:  Upload build logs
        if: always()
        uses: actions/upload-artifact@v4
        with:  
          name: build-logs-group-${{ matrix.chunk_prefix }}
          path:  Goldbach/FiniteBase/Chunks/build_*.log
          retention-days: 7
      
      - name: Upload build artifacts
        if: success()
        uses: actions/upload-artifact@v4
        with:  
          name: build-artifacts-group-${{ matrix.chunk_prefix }}
          path: . lake/build/lib/Goldbach/FiniteBase/Chunks/Chunk${{ matrix.chunk_prefix }}_*. olean
          retention-days:  1

  # Job 3: Collect results and report overall status
  summary:
    needs:  [discover-chunks, build-chunks]
    runs-on: ubuntu-latest
    if: always()  # Run even if some builds failed
    steps:
      - name: Download all build logs
        if: always()
        uses: actions/download-artifact@v4
        with:
          pattern: build-logs-group-*
          path:  all-logs
      
      - name: Analyze results
        if: always()
        run: |
          echo "=========================================="
          echo "FINAL BUILD SUMMARY"
          echo "=========================================="
          echo "Total chunks found:  ${{ needs.discover-chunks. outputs.total_chunks }}"
          echo "Build status: ${{ needs.build-chunks.result }}"
          echo ""
          
          # Count successes and failures from logs
          if [ -d "all-logs" ]; then
            success_count=$(grep -r "✓ SUCCESS:" all-logs/ 2>/dev/null | wc -l)
            failure_count=$(grep -r "✗ FAILED:" all-logs/ 2>/dev/null | wc -l)
            
            echo "Successful builds: $success_count"
            echo "Failed builds:      $failure_count"
            echo ""
            
            if [ $failure_count -gt 0 ]; then
              echo "FAILED CHUNKS:"
              grep -r "✗ FAILED:" all-logs/ | sed 's/.*✗ FAILED:  /  /' | sort -u
              echo ""
            fi
          fi
          
          echo "=========================================="
          
          if [ "${{ needs.build-chunks.result }}" == "success" ]; then
            echo ""
            echo "🎉 SUCCESS!  All chunk groups built successfully!"
            echo ""
            echo "Next steps:"
            echo "  1. All chunks are now compiled"
            echo "  2. You can now work on completeness verification"
            echo "  3. Build artifacts are available for 1 day"
            exit 0
          else
            echo ""
            echo "⚠️ Some chunks failed to build"
            echo ""
            echo "Action items:"
            echo "  1. Check the job logs for failed groups"
            echo "  2. Review error messages for specific chunks"
            echo "  3. Build logs are available for 7 days"
            exit 1
          fi
